<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.free-mmm.disable-cloud-sync</string>
            <key>PayloadUUID</key>
            <string>98F53B75-7D2F-4C18-971D-30D4F5A26012</string>
            <key>PayloadDisplayName</key>
            <string>Disable iCloud &amp; Cloud Storage Sync</string>
            <key>PayloadDescription</key>
            <string>Disables iCloud Drive, iCloud Photos, iCloud Contacts, iCloud Calendar, and Desktop/Documents sync at the macOS policy level.</string>
            
            <!-- Apple MDM / Configuration Profile Restrictions -->
            <key>allowCloudDocumentSync</key>
            <false/>
            <key>allowCloudPhotoLibrary</key>
            <false/>
            <key>allowCloudAddressBook</key>
            <false/>
            <key>allowCloudCalendar</key>
            <false/>
            <key>allowCloudReminders</key>
            <false/>
            <key>allowCloudNotes</key>
            <false/>
            <key>allowCloudMail</key>
            <false/>
            <key>allowCloudBookmarks</key>
            <false/>
            <key>allowCloudDesktopAndDocuments</key>
            <false/>
            <key>allowCloudKeychainFile</key>
            <false/>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>free-mmm: Disable Cloud Sync Restrictions</string>
    <key>PayloadIdentifier</key>
    <string>com.free-mmm.profile</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>4F2A3816-B587-4B52-870D-47C8B56891A3</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
